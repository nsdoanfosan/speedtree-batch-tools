+	// A Voxelize assembly must enter its final reduction from already reduced
+	// voxel roots. Otherwise the base mesh is mixed with voxelized part roots and
+	// the assembly reduction falls back to tracing the full source triangle scene.
+	if (bIsAssembly && DAGSettings.ShapePreservation == ENaniteShapePreservation::Voxelize)
+	{
+		NANITE_BUILD_TIME_LOG_SCOPE(NaniteAssemblyBaseReduce);
+
+		for (int32 MeshIndex = 0; MeshIndex < InputMeshData.TriangleCounts.Num(); MeshIndex++)
+		{
+			Resources.ClusterDAG.ReduceMesh(MeshIndex);
+
+			// ReduceMesh terminates each standalone mesh with a synthetic root group.
+			// The base root is about to become a child of the combined assembly DAG, so
+			// keeping that standalone root would assign the same non-instanced cluster
+			// to two page groups. Preserve the generated voxel hierarchy and root
+			// cluster, but remove only the temporary standalone root wrapper.
+			check(!Resources.ClusterDAG.Groups.IsEmpty());
+			const FClusterGroup& BaseRootGroup = Resources.ClusterDAG.Groups.Last();
+			check(BaseRootGroup.bRoot && BaseRootGroup.MeshIndex == (uint32)MeshIndex);
+			Resources.ClusterDAG.Groups.Pop(EAllowShrinking::No);
+		}
+
+		UE_LOGF(LogStaticMesh, Display, "Nanite Assembly voxel reuse enabled: base and part voxel roots will be regridded without full-scene triangle tracing.");
