+	bool bInheritAssemblyVoxels = !DAG.AssemblyInstanceData.IsEmpty() && !Children.IsEmpty();
+	for( FClusterRef ChildRef : Children )
+	{
+		bInheritAssemblyVoxels &= ChildRef.GetCluster( DAG ).IsVoxel();
+	}
+
+	if( bInheritAssemblyVoxels )
+	{
+		struct FInheritedVoxel
+		{
+			uint32 ClusterIndex;
+			uint32 InstanceIndex;
+			uint32 VertIndex;
+			uint32 BrickIndex;
+			float DistanceSq;
+		};
+
+		TArray< FInheritedVoxel > InheritedVoxels;
+
+		for( FClusterRef ChildRef : Children )
+		{
+			const FCluster& Child = ChildRef.GetCluster( DAG );
+
+			FMatrix44f Transform = FMatrix44f::Identity;
+			if( ChildRef.IsInstance() )
+			{
+				Transform = ChildRef.GetTransform( DAG );
+			}
+
+			for( uint32 BrickIndex = 0; BrickIndex < (uint32)Child.Bricks.Num(); BrickIndex++ )
+			{
+				const FBrick& Brick = Child.Bricks[ BrickIndex ];
+				const uint32 NumVoxels = FMath::CountBits64( Brick.VoxelMask );
+
+				for( uint32 i = 0; i < NumVoxels; i++ )
+				{
+					const uint32 VertIndex = Brick.VertOffset + i;
+					const FVector3f LocalCenter = Child.Verts.GetPosition( VertIndex );
+					FVector3f WorldCenter = LocalCenter;
+					if( ChildRef.IsInstance() )
+					{
+						WorldCenter = Transform.TransformPosition( LocalCenter );
+					}
+
+					FBounds3f VoxelBounds = {
+						LocalCenter - Child.LODError * 0.5f,
+						LocalCenter + Child.LODError * 0.5f
+					};
+					if( ChildRef.IsInstance() )
+					{
+						VoxelBounds = VoxelBounds.TransformBy( Transform );
+					}
+
+					const FIntVector3 MinVoxel = FloorToInt( FVector3f( VoxelBounds.Min ) * RcpVoxelSize );
+					const FIntVector3 MaxVoxel = FloorToInt( FVector3f( VoxelBounds.Max ) * RcpVoxelSize );
+
+					for( int32 z = MinVoxel.Z; z <= MaxVoxel.Z; z++ )
+					{
+						for( int32 y = MinVoxel.Y; y <= MaxVoxel.Y; y++ )
+						{
+							for( int32 x = MinVoxel.X; x <= MaxVoxel.X; x++ )
+							{
+								const FIntVector3 Voxel( x, y, z );
+								const FVector3f DstCenter = ( Voxel + 0.5f ) * VoxelSize;
+								const float DistanceSq = FVector3f::DistSquared( DstCenter, WorldCenter );
+
+								uint32& VoxelIndex = VoxelMap.FindOrAdd( Voxel, VoxelMap.Num() );
+								if( VoxelIndex == (uint32)InheritedVoxels.Num() )
+								{
+									InheritedVoxels.Add( {
+										ChildRef.ClusterIndex,
+										ChildRef.InstanceIndex,
+										VertIndex,
+										BrickIndex,
+										DistanceSq
+									} );
+								}
+								else if( DistanceSq < InheritedVoxels[ VoxelIndex ].DistanceSq )
+								{
+									InheritedVoxels[ VoxelIndex ] = {
+										ChildRef.ClusterIndex,
+										ChildRef.InstanceIndex,
+										VertIndex,
+										BrickIndex,
+										DistanceSq
+									};
+								}
+							}
+						}
+					}
+				}
+			}
+		}
+
+		if( !VoxelMap.IsEmpty() )
+		{
+			for( auto& Voxel : VoxelMap )
+			{
+				const FInheritedVoxel& Source = InheritedVoxels[ Voxel.Value ];
+				const FCluster& Child = DAG.Clusters[ Source.ClusterIndex ];
+
+				const uint32 NewIndex = Verts.AddUninitialized();
+				Voxel.Value = NewIndex;
+
+				CopyAttributes( NewIndex, Source.VertIndex, Child );
+				Verts.GetPosition( NewIndex ) = ( Voxel.Key + 0.5f ) * VoxelSize;
+				MaterialIndexes.Add( Child.MaterialIndexes[ Source.BrickIndex ] );
+
+				if( Source.InstanceIndex != MAX_uint32 )
+				{
+					const FAssemblyInstanceData& InstanceData = DAG.AssemblyInstanceData[ Source.InstanceIndex ];
+					const FMatrix44f NormalTransform = InstanceData.Transform.GetMatrixWithoutScale();
+
+					FVector3f& Normal = Verts.GetNormal( NewIndex );
+					Normal = NormalTransform.TransformVector( Normal ).GetSafeNormal();
+
+					if( Verts.Format.bHasTangents )
+					{
+						FVector3f& TangentX = Verts.GetTangentX( NewIndex );
+						TangentX = NormalTransform.TransformVector( TangentX ).GetSafeNormal();
+					}
+
+					if( Verts.Format.bHasCurveRadius )
+					{
+						Verts.GetCurveRadius( NewIndex ) *= InstanceData.Transform.GetMaximumAxisScale();
+					}
+
+					if( InstanceData.NumBoneInfluences > 0 )
+					{
+						check( Verts.Format.NumBoneInfluences >= InstanceData.NumBoneInfluences );
+						FMemory::Memcpy(
+							Verts.GetBoneInfluences( NewIndex ),
+							&DAG.AssemblyBoneInfluences[ InstanceData.FirstBoneInfluence ],
+							InstanceData.NumBoneInfluences * sizeof( FVector2f ) );
+					}
+					FMemory::Memzero(
+						Verts.GetBoneInfluences( NewIndex ) + InstanceData.NumBoneInfluences,
+						( Verts.Format.NumBoneInfluences - InstanceData.NumBoneInfluences ) * sizeof( FVector2f ) );
+				}
+
+				CorrectAttributesFunctions[ Verts.Format.bHasTangents ][ Verts.Format.bHasCurveRadius ][ Verts.Format.bHasColors ]( Verts.GetAttributes( NewIndex ) );
+			}
+
+			check( MaterialIndexes.Num() > 0 );
+			VoxelsToBricks( VoxelMap );
+			return;
+		}
+	}
+
 	for( FClusterRef ChildRef : Children )
 	{
 		const FCluster& Child = ChildRef.GetCluster( DAG );
