@@ -1642,6 +1642,161 @@ void FCluster::Voxelize( FClusterDAG& DAG, TArrayView< const FClusterRef > Child
 	check( VoxelSize > 0.0f );
 	const float RcpVoxelSize = 1.0f / VoxelSize;
 
+	// Assembly parts have already built their own voxel hierarchy. When the
+	// final assembly level contains only voxel roots, inherit those bricks and
+	// their attributes instead of returning to the full source triangle scene.
+	// The destination grid is still rebuilt so transformed/overlapping parts can
+	// be combined at the parent LOD; only the redundant triangle ray tracing is
